{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noty",
  "version": "0.1.0",
  "identifier": "com.noty.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noty 设置",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      },
      {
        "label": "dock",
        "title": "Noty Dock",
        "url": "index.html#/dock",
        "width": 500,
        "height": 720,
        "minWidth": 104,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "dock-toast",
        "title": "Noty Toast",
        "url": "index.html#/dock-toast",
        "width": 320,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
