{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flank",
  "version": "0.1.4",
  "identifier": "com.flank.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flank",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "dock",
        "title": "Flank Dock",
        "url": "index.html#/dock",
        "width": 104,
        "height": 720,
        "minWidth": 40,
        "minHeight": 1,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "dock-panel",
        "title": "Flank Panel",
        "url": "index.html#/dock-panel",
        "width": 432,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "本地优先的桌面便签",
    "longDescription": "来不及整理的，先放在手边。Flank 把常用便签收进屏幕边缘，支持全局速记、Markdown 与待办，正文加密保存在本地，无需注册账号。",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTQ1NEU5NUZCOTA3RjkKUldUNUI3bGY2VlRrSXI3UXhLaFpDQVVQeHg1Zy8ycUozS1NseGZCdUR4bmlMdGZFSVN1SXJpVk0K",
      "endpoints": [
        "https://github.com/qbbmnnnnnn/flank/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
